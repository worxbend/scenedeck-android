require "json"

default_platform(:android)

platform :android do
  desc "Upload a signed Android App Bundle to an existing Google Play app"
  lane :publish do
    aab_path = ENV.fetch("AAB_PATH", "")
    key_path = ENV["PLAY_JSON_KEY_PATH"].to_s
    key_path = ENV.fetch("GOOGLE_APPLICATION_CREDENTIALS", "") if key_path.empty?
    track = ENV.fetch("PLAY_TRACK", "internal")
    release_status = ENV.fetch("PLAY_RELEASE_STATUS", "draft")
    package_name = ENV.fetch("PACKAGE_NAME", "com.worxbend.scenedeck")
    upload_metadata = ENV.fetch("PLAY_UPLOAD_METADATA", "false")
    metadata_path = ENV.fetch("PLAY_METADATA_PATH", File.expand_path("metadata/android", __dir__))

    UI.user_error!("AAB_PATH must point to an existing .aab file") unless
      File.file?(aab_path) && File.extname(aab_path).downcase == ".aab"
    UI.user_error!("PLAY_JSON_KEY_PATH or GOOGLE_APPLICATION_CREDENTIALS must point to an existing credentials file") unless
      File.file?(key_path)
    UI.user_error!("PLAY_TRACK must be internal, beta, or production") unless
      %w[internal beta production].include?(track)
    UI.user_error!("PLAY_RELEASE_STATUS must be draft or completed") unless
      %w[draft completed].include?(release_status)
    UI.user_error!("PACKAGE_NAME must be a valid Android application ID") unless
      /\A[a-zA-Z][a-zA-Z0-9_]*(?:\.[a-zA-Z][a-zA-Z0-9_]*)+\z/.match?(package_name)
    UI.user_error!("PLAY_UPLOAD_METADATA must be true or false") unless
      %w[true false].include?(upload_metadata)
    UI.user_error!("PLAY_METADATA_PATH must contain a store listing when metadata upload is enabled") if
      upload_metadata == "true" && Dir.glob(File.join(metadata_path, "*", "title.txt")).empty?

    begin
      credentials = JSON.parse(File.read(key_path))
    rescue JSON::ParserError
      UI.user_error!("Google credentials file must contain valid JSON")
    end
    UI.user_error!("Google credentials must be service_account or external_account") unless
      credentials.is_a?(Hash) && %w[service_account external_account].include?(credentials["type"])

    options = {
      package_name: package_name,
      json_key: File.expand_path(key_path),
      aab: File.expand_path(aab_path),
      track: track,
      release_status: release_status,
      skip_upload_apk: true,
      skip_upload_metadata: upload_metadata != "true",
      skip_upload_changelogs: upload_metadata != "true",
      skip_upload_images: upload_metadata != "true",
      skip_upload_screenshots: upload_metadata != "true"
    }
    options[:metadata_path] = File.expand_path(metadata_path) if upload_metadata == "true"
    upload_to_play_store(**options)
  end
end
